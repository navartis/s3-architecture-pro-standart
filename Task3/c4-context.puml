@startuml
!include <C4/C4_Context>

LAYOUT_LEFT_RIGHT()
title Контекст: открытие депозитов онлайн (MVP)

Person(client, "Клиент", "Свой клиент банка или новый, пришедший с сайта")
Person(backoffice, "Сотрудник бэк-офиса депозитов", "Подтверждает ставку и открывает депозит в АБС")
Person(operator, "Оператор колл-центра", "Консультирует по ставкам и звонит по заявкам с сайта")

System(ib, "Интернет-банк", "Личный кабинет: платежи и счета. Расширяется модулем депозитов")
System(site, "Сайт", "Маркетинговый сайт. Получает форму заявки на депозит")
System(cc, "Система колл-центра", "CRM подрядчика, обращения клиентов")

System_Ext(abs, "АБС", "Учёт счетов и бухгалтерия. Система записи по депозитам")
System_Ext(sms, "СМС-шлюз", "Отправка СМС через телеком-оператора")

Rel(client, ib, "Смотрит ставки, подаёт заявку")
Rel(client, site, "Подаёт заявку на депозит")
Rel(site, ib, "Передаёт заявку")
Rel(operator, cc, "Работает в системе")
Rel(cc, ib, "Получает актуальные ставки", "API")
Rel(ib, abs, "Регистрирует заявку, читает статус")
Rel(ib, sms, "Просит отправить СМС")
Rel(backoffice, abs, "Подтверждает ставку, открывает депозит")

@enduml
