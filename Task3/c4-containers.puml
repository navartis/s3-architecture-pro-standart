@startuml
!include <C4/C4_Container>

LAYOUT_LEFT_RIGHT()
title Контейнеры: интернет-банк и АБС детализированы

Person(client, "Клиент", "Свой или новый клиент банка")
Person(backoffice, "Сотрудник бэк-офиса депозитов", "Подтверждает ставку и открывает депозит")
Person(operator, "Оператор колл-центра", "Консультирует по ставкам, звонит по заявкам с сайта")

System_Boundary(ib_b, "Интернет-банк") {
  Container(web, "Веб-приложение", "ASP.NET MVC 4.5", "Страницы кабинета, вход, подтверждение СМС-кодом")
  Container(dep, "Модуль депозитов", "ASP.NET MVC, новый", "Домен заявки: приём, валидация, статусы, REST для сайта")
  Container(core, "Ядро платежей", "ASP.NET MVC", "Платежи и текущие счета. Не меняется")
  ContainerDb(dbib, "БД интернет-банка", "MS SQL", "Заявки, статусы, идемпотентность")
}

System_Boundary(abs_b, "АБС") {
  Container(abs_ui, "Рабочее место", "Delphi-клиент", "Интерфейс сотрудников отделения и бэк-офиса")
  Container(abs_logic, "Бизнес-логика", "PL/SQL процедуры", "Открытие счетов, проводки, ставки по договору")
  ContainerDb(abs_db, "БД АБС", "Oracle", "Счета, договоры, бухгалтерия. Перегружена")
}

Container_Boundary(int_b, "Сервис интеграции с АБС") {
  Container(int, "Обработчик заявок", "Java Spring, новый", "Единственный путь в АБС: вызовы процедур, ограничитель потока, идемпотентность")
  ContainerDb(outbox, "Очередь и outbox", "PostgreSQL, новая", "Состояния NEW, SENT, CONFIRMED, PARKED, события статусов")
  ContainerDb(parking, "Парковка", "PostgreSQL, новая", "Заявки на ручной разбор и повтор")
}

Container(rate, "Сервис ставок", "Java Spring, новый", "Расчёт по расписанию, API для каналов, выгрузка файлов")
ContainerDb(ratedb, "БД ставок", "PostgreSQL", "Ставки по продуктам, персональные ставки, история")

System_Ext(site, "Сайт", "PHP + React. Принимает заявку на депозит")
System_Ext(cc, "Система колл-центра", "React + Spring, платформа подрядчика")
Container_Ext(sms, "СМС-шлюз", "Внешний", "Отправка СМС через телеком-оператора")

Rel(client, web, "Открывает кабинет")
Rel(client, site, "Подаёт заявку на депозит")
Rel(site, dep, "Передаёт заявку", "REST")
Rel(dep, cc, "Передаёт заявку с сайта")
Rel(operator, cc, "Работает")
Rel(cc, rate, "Запрашивает ставки", "REST")
Rel(web, dep, "Передаёт запрос")
Rel(web, core, "Платежи")
Rel(dep, dbib, "Читает и пишет заявки")
Rel(dep, rate, "Запрашивает ставки", "REST")
Rel(dep, int, "Отправляет заявку", "REST")
Rel(int, outbox, "Пишет заявку и событие")
Rel(int, parking, "Отправляет на разбор")
Rel(int, abs_logic, "Вызывает процедуры, получает статус")
Rel(int, sms, "Просит отправить СМС")
Rel(rate, ratedb, "Читает и пишет ставки")
Rel(backoffice, abs_ui, "Работает")
Rel(abs_ui, abs_logic, "")
Rel(abs_logic, abs_db, "")

@enduml
