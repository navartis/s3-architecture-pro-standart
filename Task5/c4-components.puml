@startuml
!include <C4/C4_Component>

LAYOUT_LEFT_RIGHT()
title Компоненты сервиса кредитных заявок

System_Boundary(cs_b, "Сервис кредитных заявок") {
  Component(api, "API заявок", "REST", "Приём заявки с сайта и из интернет-банка, идемпотентность")
  Component(queue, "Очередь заявок", "БД и планировщик", "Заявки в работе, повторные попытки, приоритет своих клиентов")
  Component(orch, "Оркестратор проверки", "Java-сервис", "Скоринг, БКИ, решение по правилам, кэш результата на 30 дней")
  Component(limit, "Ограничитель темпа", "Token bucket", "Квота запросов к БКИ, дедупликация по клиенту")
  Component(conn, "Клиент конвейера", "REST-клиент", "Передача заявки в конвейер и отметка о ручной обработке")
  Component(admin, "Административный интерфейс", "Веб", "Ручная обработка и разбор зависших заявок")
  Component(sched, "Планировщик предодобренных", "Планировщик", "Ночной расчёт предложений по своим клиентам")
  ContainerDb(db, "БД заявок", "MS SQL", "Заявки, статусы, результаты проверки")
}

System_Ext(scoring, "Система скоринга", "")
System_Ext(bki, "Бюро кредитных историй", "")
System_Ext(pipe, "Кредитный конвейер", "")
System_Ext(sms, "СМС-шлюз", "")

Rel(api, queue, "Регистрирует заявку")
Rel(queue, orch, "Отдаёт на проверку")
Rel(orch, scoring, "Запрашивает скоринг", "REST")
Rel(scoring, bki, "Запрашивает историю", "REST")
Rel(orch, limit, "Соблюдает квоту")
Rel(orch, conn, "Передаёт заявку")
Rel(conn, pipe, "Отправляет заявку", "REST")
Rel(orch, db, "Пишет статусы и результат")
Rel(queue, db, "Хранит заявки")
Rel(sched, scoring, "Считает предодобрение ночью")
Rel(orch, sms, "Просит отправить СМС")
Rel(admin, db, "Разбирает зависшие заявки")

@enduml
