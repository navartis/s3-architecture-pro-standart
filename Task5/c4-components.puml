@startuml
!include <C4/C4_Component>

LAYOUT_LEFT_RIGHT()
title Компоненты сервиса кредитных заявок

System_Boundary(cs_b, "Сервис кредитных заявок") {
  Component(api, "API заявок", "REST", "Прием с сайта и из интернет-банка, идемпотентность, дедупликация")
  Component(registry, "Реестр заявок", "Java-сервис", "Единый источник правды по заявке и ее статусам")
  Component(queue, "Очередь заявок", "БД и планировщик", "Заявки в работе, повторные попытки, приоритет своих клиентов")
  Component(orch, "Оркестратор проверки", "Java-сервис", "Скоринг, БКИ, правило предварительного решения, кэш на 30 дней")
  Component(limit, "Ограничитель темпа", "Token bucket", "Квота БКИ, приоритет онлайн-запросов")
  Component(conn, "Клиент конвейера", "REST-клиент", "Передача заявки в конвейер и прием статусов")
  Component(status, "Шлюз статусов", "REST", "Одноразовые токены и страница статуса")
  Component(abs_adapter, "Адаптер АБС", "REST-клиент", "Создать или продолжить, поиск по телефону и паспорту")
  Component(sched, "Планировщик предодобрений", "Планировщик", "Триггеры, TTL 30 дней, когорта онлайн-активных")
  Component(outbox, "Outbox", "Таблица и релей", "События статусов в одной транзакции с изменением")
  Component(parking, "Парковка и админка", "Веб", "Ручной разбор зависших заявок и отказов БКИ")
  ContainerDb(db, "БД заявок", "PostgreSQL", "Заявки, статусы, результаты проверки, токены")
}

System_Ext(scoring, "Система скоринга", "")
System_Ext(bki, "Бюро кредитных историй", "")
System_Ext(pipe, "Кредитный конвейер", "")
System_Ext(sms, "СМС-шлюз", "")
System_Ext(abs, "АБС", "")
System_Ext(site, "Сайт", "")

Rel(api, registry, "Регистрирует заявку")
Rel(api, queue, "Ставит в очередь")
Rel(queue, orch, "Отдаёт на проверку")
Rel(orch, scoring, "Запрашивает скоринг", "REST")
Rel(scoring, bki, "Запрашивает историю", "REST")
Rel(orch, limit, "Соблюдает квоту")
Rel(orch, conn, "Передаёт заявку")
Rel(conn, pipe, "Отправляет заявку", "REST")
Rel(pipe, conn, "Возвращает статус", "REST")
Rel(orch, db, "Пишет статусы и результат")
Rel(registry, db, "Хранит заявки")
Rel(status, db, "Читает статус по токену")
Rel(sched, scoring, "Считает предодобрение")
Rel(orch, sms, "Просит отправить код и СМС")
Rel(orch, outbox, "Пишет событие")
Rel(orch, parking, "Отправляет на разбор")
Rel(abs_adapter, abs, "Создать или продолжить", "REST")
Rel(abs_adapter, registry, "Ищет заявку по телефону и паспорту")
Rel(api, abs_adapter, "Продолжение из отделения")

@enduml
