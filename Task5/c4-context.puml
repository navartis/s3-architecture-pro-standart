@startuml
!include <C4/C4_Context>

LAYOUT_LEFT_RIGHT()
title Контекст: заявка на кредит онлайн

Person(client, "Клиент", "Свой клиент с предодобрением или новый, о котором знает только БКИ")
Person(cred, "Сотрудник кредитования", "Работает с заявкой в конвейере и принимает решение")

System(site, "Сайт", "Форма кредитной заявки")
System(ib, "Интернет-банк", "Список кредитов и предодобренное предложение")
System(cs, "Сервис кредитных заявок", "Приём, очередь, проверка, передача в конвейер")

System_Ext(scoring, "Система скоринга", "Считает рейтинг клиента и вызывает БКИ")
System_Ext(bki, "Бюро кредитных историй", "Кредитная история, REST")
System_Ext(pipe, "Кредитный конвейер", "Camunda. Обработка заявок и решение сотрудника")
System_Ext(sms, "СМС-шлюз", "Уведомления о статусе заявки")

Rel(client, site, "Подаёт заявку")
Rel(client, ib, "Видит предложение, подаёт заявку")
Rel(site, cs, "Передаёт заявку", "REST")
Rel(ib, cs, "Передаёт заявку и читает предодобрение", "REST")
Rel(cs, scoring, "Запрашивает проверку", "REST")
Rel(scoring, bki, "Запрашивает историю", "REST")
Rel(cs, pipe, "Передаёт заявку", "REST")
Rel(cred, pipe, "Принимает решение")
Rel(cs, sms, "Просит отправить СМС")

@enduml
