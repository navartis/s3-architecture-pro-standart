@startuml
!include <C4/C4_Context>

LAYOUT_LEFT_RIGHT()
title Контекст: заявка на кредит онлайн

Person(client, "Клиент", "Новый клиент с сайта или свой клиент интернет-банка")
Person(branch, "Сотрудник отделения", "Находит заявку с сайта и продолжает ее в АБС")
Person(cred, "Сотрудник кредитования", "Работает с заявкой в конвейере и принимает финальное решение")

System(site, "Сайт", "Форма кредитной заявки, подтверждение телефона, страница статуса")
System(ib, "Интернет-банк", "Список кредитов, предодобренное предложение")
System(cs, "Сервис кредитных заявок", "Реестр, проверка, статусы, передача в конвейер")

System_Ext(abs, "АБС", "Заявки из отделений, кредитные договоры")
System_Ext(scoring, "Система скоринга", "Считает рейтинг клиента и вызывает БКИ")
System_Ext(bki, "Бюро кредитных историй", "Кредитная история, REST. Квота по договору")
System_Ext(pipe, "Кредитный конвейер", "Camunda. Обработка заявок и решение сотрудника")
System_Ext(sms, "СМС-шлюз", "Коды подтверждения и уведомления о статусе")

Rel(client, site, "Подает заявку, подтверждает телефон, смотрит статус по токену")
Rel(client, ib, "Видит предложение, подаёт заявку")
Rel(site, cs, "Передаёт заявку", "REST")
Rel(ib, cs, "Передаёт заявку и читает предодобрение", "REST")
Rel(cs, scoring, "Запрашивает проверку", "REST")
Rel(scoring, bki, "Запрашивает историю", "REST")
Rel(cs, pipe, "Передаёт заявку", "REST")
Rel(pipe, cs, "Возвращает статус", "REST")
Rel(cs, sms, "Просит отправить код и СМС о статусе")
Rel(cred, pipe, "Принимает решение")
Rel(branch, abs, "Работает в АБС")
Rel(abs, cs, "Создать или продолжить", "REST")
Rel(cs, abs, "Возвращает номер и решение", "REST")

@enduml
