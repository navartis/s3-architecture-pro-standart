@startuml
!include <C4/C4_Context>

LAYOUT_LEFT_RIGHT()
title Контекст: передача ставок в колл-центры

Person(operator, "Оператор банковского колл-центра", "Консультирует клиентов по депозитным ставкам")
Person(backoffice, "Сотрудник бэк-офиса", "Ведёт ставки и уровень кредитного риска")

System(cc, "Система колл-центра", "CRM подрядчика. Получает новый экран со ставками")
System(rate, "Сервис ставок", "Расчёт, хранение и выдача ставок. Выгрузка файлов для партнёра")

System_Ext(abs, "АБС", "Источник уровня кредитного риска и ставки рефинансирования")
System_Ext(sftp, "SFTP-сервер", "Обмен файлами с партнёром, DMZ")
System_Ext(partner, "Партнёрский колл-центр", "Забирает файлы ставок по расписанию, API не поддерживает")

Rel(operator, cc, "Работает и видит ставки")
Rel(backoffice, rate, "Ведёт ставки")
Rel(cc, rate, "Запрашивает ставки", "REST")
Rel(abs, rate, "Отдаёт уровень риска и ставку ЦБ")
Rel(rate, sftp, "Выкладывает файл по расписанию")
Rel(sftp, partner, "Партнёр забирает файлы")

@enduml
