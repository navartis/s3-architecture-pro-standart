@startuml
!include <C4/C4_Component>

LAYOUT_LEFT_RIGHT()
title Компоненты сервиса ставок

Person(backoffice, "Сотрудник бэк-офиса", "Ведёт ставки по депозитам и кредитам")

System_Boundary(rate_b, "Сервис ставок") {
  Component(api, "API ставок", "REST", "Чтение ставок по продукту и клиенту, кэш на минуту")
  Component(sched, "Планировщик расчёта", "Планировщик", "Ежедневный пересчёт ставок по расписанию")
  Component(admin, "Административный интерфейс", "Веб", "Ведение ставок бэк-офисом, разграничение ролей")
  Component(exp, "Экспортёр файлов", "Планировщик и SFTP-клиент", "Формирует CSV со ставками и выкладывает на SFTP")
  ContainerDb(db, "БД ставок", "PostgreSQL", "Ставки по продуктам, персональные, история изменений")
}

System_Ext(cc, "Система колл-центра", "Экран ставок для оператора")
System_Ext(abs, "АБС", "Уровень кредитного риска и ставка рефинансирования")
System_Ext(sftp, "SFTP-сервер", "Приём файлов ставок")
System_Ext(partner, "Партнёрский колл-центр", "Забирает файл по расписанию")

Rel(backoffice, admin, "Работает")
Rel(cc, api, "Запрашивает ставки", "REST")
Rel(api, db, "Читает ставки")
Rel(sched, abs, "Запрашивает риск и ставку ЦБ")
Rel(sched, db, "Записывает ставки")
Rel(admin, db, "Правит ставки")
Rel(exp, db, "Читает ставки")
Rel(exp, sftp, "Выкладывает CSV с паролем")
Rel(sftp, partner, "Отдаёт файл")

@enduml
